<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GezginRotası2.RandomAdventurePage"
             Title="🎲 Kararsızım / Şans Çarkı"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" HorizontalOptions="Center" MaximumWidthRequest="450">

            <!-- Üst Açıklama -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="Nereye Gitsem? Ne Yesem?" TextColor="#FF7F00" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="Kararsız kaldıysan butona bas, Türkiye sana bir rota çizsin!" TextColor="#AAAAAA" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Çark / Zar İkonu (Animasyonlu) -->
            <Border x:Name="DiceBorder"
                    BackgroundColor="#1E1E1E" 
                    Stroke="#FF7F00" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 50" 
                    WidthRequest="100" 
                    HeightRequest="100"
                    HorizontalOptions="Center">
                <Label x:Name="DiceLabel" Text="🎲" FontSize="44" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Çevir Butonu -->
            <Button x:Name="SpinButton"
                    Text="✨ Bana Sürpriz Bir Rota Seç!" 
                    Clicked="OnSpinClicked"
                    BackgroundColor="#FF7F00" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="16" 
                    HeightRequest="52" 
                    FontSize="15"
                    Padding="20,0"/>

            <!-- SÜRPRİZ KART ALANI -->
            <Border x:Name="ResultCard" 
                    IsVisible="False"
                    BackgroundColor="#1E1E1E" 
                    Stroke="#333333" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 20" 
                    Padding="20"
                    Margin="0,10,0,20">
                <VerticalStackLayout Spacing="14">

                    <!-- Başlık & Şehir -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="🎉 Şansına Çıkan Şehir:" TextColor="#888888" FontSize="11"/>
                            <Label x:Name="ResultCityLabel" Text="Kayseri" TextColor="White" FontSize="22" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="#FF7F00" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,4" VerticalOptions="Center">
                            <Label x:Name="ResultRegionLabel" Text="İç Anadolu" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2A2A2A"/>

                    <!-- Gezilecek Yer -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="🏛️ Gezilecek Saklı Köşe" TextColor="#FF7F00" FontSize="12" FontAttributes="Bold"/>
                        <Label x:Name="ResultPlaceLabel" Text="Erciyes Dağı &amp; Tarihi Kapalı Çarşı" TextColor="#EEEEEE" FontSize="14"/>
                    </VerticalStackLayout>

                    <!-- Meşhur Yemek -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="🍲 Tadılacak Meşhur Lezzet" TextColor="#E91E63" FontSize="12" FontAttributes="Bold"/>
                        <Label x:Name="ResultFoodLabel" Text="Kayseri Yağlaması &amp; Mantı" TextColor="#EEEEEE" FontSize="14"/>
                    </VerticalStackLayout>

                    <!-- Dinlenecek Türkü -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="🎶 Yol Şarkısı / Türküsü" TextColor="#3F51B5" FontSize="12" FontAttributes="Bold"/>
                        <Label x:Name="ResultSongLabel" Text="Gesi Bağları - Selda Bağcan" TextColor="#EEEEEE" FontSize="14"/>
                    </VerticalStackLayout>

                    <!-- Hızlı Harita Butonu -->
                    <Button Text="🗺️ Bu Şehri Google Haritalar'da Gör" 
                            Clicked="OnExploreCityClicked"
                            BackgroundColor="#2D2D2D" 
                            TextColor="#FF7F00" 
                            CornerRadius="12" 
                            HeightRequest="42" 
                            FontSize="12"
                            Margin="0,6,0,0"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>