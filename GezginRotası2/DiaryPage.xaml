<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GezginRotası2"
             x:Class="GezginRotası2.DiaryPage"
             Title="📓 Gezgin Günlüğüm"
             BackgroundColor="#0D0F15">

    <Grid RowDefinitions="Auto, *">

        <!-- Üst Başlık ve Yeni Anı Ekle Butonu -->
        <Border Grid.Row="0" BackgroundColor="#181B24" StrokeThickness="0" Padding="18,14">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="3">
                    <Label x:Name="PageHeaderLabel" Text="Gezi Notlarım &amp; Anılarım" TextColor="#FF7F00" FontSize="18" FontAttributes="Bold"/>
                    <Label x:Name="PageSubtitleLabel" Text="Gittiğin yerlerdeki hatıralarını ölümsüzleştir" TextColor="#8E95A5" FontSize="11"/>
                </VerticalStackLayout>

                <Button Grid.Column="1" 
                        x:Name="BtnNewEntry"
                        Text="✍️ Yeni Anı Yaz" 
                        Clicked="OnAddEntryClicked"
                        BackgroundColor="#FF7F00" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        CornerRadius="12" 
                        HeightRequest="40" 
                        FontSize="12"/>
            </Grid>
        </Border>

        <!-- Anı Kartları Listesi -->
        <CollectionView Grid.Row="1" 
                        x:Name="DiaryCollection"
                        Margin="15,10">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="30">
                    <Label Text="📖" FontSize="50" HorizontalOptions="Center"/>
                    <Label x:Name="EmptyTitleLabel" Text="Henüz bir gezi anısı eklemediniz." TextColor="#CCCCCC" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label x:Name="EmptySubtitleLabel" Text="'Yeni Anı Yaz' butonuna basarak ilk hatıranızı kaydedin!" TextColor="#707688" FontSize="13" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:DiaryEntry">
                    <Grid Padding="0,5">
                        <Border BackgroundColor="#181B24" 
                                Stroke="#262C3A" 
                                StrokeThickness="1" 
                                StrokeShape="RoundRectangle 16" 
                                Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <!-- Üst Bilgi: Şehir + Tarih + Ruh Hali -->
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                        <Label Text="{Binding MoodEmoji}" FontSize="18"/>
                                        <Border BackgroundColor="#222734" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,2">
                                            <Label Text="{Binding City}" TextColor="#FF7F00" FontSize="11" FontAttributes="Bold"/>
                                        </Border>
                                    </HorizontalStackLayout>

                                    <Label Grid.Column="2" Text="{Binding DateText}" TextColor="#8E95A5" FontSize="11" VerticalOptions="Center"/>
                                </Grid>

                                <!-- Başlık -->
                                <Label Text="{Binding Title}" TextColor="White" FontSize="16" FontAttributes="Bold"/>

                                <!-- Anı Metni -->
                                <Label Text="{Binding Content}" TextColor="#A0A5B5" FontSize="13" LineHeight="1.3"/>

                                <!-- Alt Çizgi ve Sil Butonu -->
                                <BoxView HeightRequest="1" Color="#222836" Margin="0,4"/>

                                <Button Text="🗑️ Sil" 
                                        Clicked="OnDeleteClicked" 
                                        CommandParameter="{Binding Id}"
                                        BackgroundColor="Transparent" 
                                        TextColor="#FF5252" 
                                        FontSize="11" 
                                        HorizontalOptions="End" 
                                        HeightRequest="30"
                                        Padding="0"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>