<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GezginRotası2"
             x:Class="GezginRotası2.AiAssistantPage"
             Title="🤖 Gezgin AI Asistanı"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Üst Bilgi ve Hızlı Seçim Butonları -->
        <VerticalStackLayout Grid.Row="0" Padding="15,10" Spacing="8" BackgroundColor="#1E1E1E">
            <Label x:Name="CityHeaderLabel" 
                   Text="📍 Tüm Türkiye İçin Asistan" 
                   TextColor="#FF7F00" 
                   FontAttributes="Bold" 
                   FontSize="14"/>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="🗺️ 1 Günlük Rota Çiz" 
                            Clicked="OnQuickPromptClicked"
                            BackgroundColor="#2D2D2D" TextColor="#EEEEEE" CornerRadius="12" HeightRequest="36" FontSize="12"/>
                    <Button Text="🍲 Ne Yenir? (Meşhur Lezzetler)" 
                            Clicked="OnQuickPromptClicked"
                            BackgroundColor="#2D2D2D" TextColor="#EEEEEE" CornerRadius="12" HeightRequest="36" FontSize="12"/>
                    <Button Text="💰 Bütçe Dostu Gezi" 
                            Clicked="OnQuickPromptClicked"
                            BackgroundColor="#2D2D2D" TextColor="#EEEEEE" CornerRadius="12" HeightRequest="36" FontSize="12"/>
                    <Button Text="🏛️ Gizli Kalmış Yerler" 
                            Clicked="OnQuickPromptClicked"
                            BackgroundColor="#2D2D2D" TextColor="#EEEEEE" CornerRadius="12" HeightRequest="36" FontSize="12"/>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <!-- Mesajlaşma Alanı (Margin düzeltildi) -->
        <CollectionView Grid.Row="1" 
                        x:Name="MessagesCollection"
                        ItemsSource="{Binding Messages}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        Margin="15,10">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ChatMessage">
                    <Grid Padding="0,6">
                        <Border BackgroundColor="{Binding BubbleColor}"
                                HorizontalOptions="{Binding HorizontalAlignment}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="14,10"
                                MaximumWidthRequest="320">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Text}" 
                                       TextColor="White" 
                                       FontSize="14" 
                                       LineHeight="1.3"/>
                                <Label Text="{Binding TimeText}" 
                                       TextColor="#999999" 
                                       FontSize="10" 
                                       HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Yükleniyor Göstergesi -->
        <ActivityIndicator Grid.Row="1" 
                           x:Name="LoadingIndicator" 
                           IsRunning="False" 
                           IsVisible="False" 
                           Color="#FF7F00" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />

        <!-- Alt Giriş Alanı -->
        <Border Grid.Row="2" BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="12,8">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                <Border Grid.Column="0" 
                        BackgroundColor="#2A2A2A" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 20" 
                        Padding="12,0">
                    <Entry x:Name="MessageEntry"
                           Placeholder="Şehir veya lezzet hakkında bir şey sorun..."
                           PlaceholderColor="#888888"
                           TextColor="White"
                           FontSize="14"
                           Completed="OnSendClicked"/>
                </Border>

                <Button Grid.Column="1"
                        Text="🚀"
                        Clicked="OnSendClicked"
                        BackgroundColor="#FF7F00"
                        CornerRadius="20"
                        WidthRequest="46"
                        HeightRequest="46"
                        Padding="0"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>