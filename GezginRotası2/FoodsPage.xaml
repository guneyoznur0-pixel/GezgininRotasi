<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GezginRotası2"
             x:Class="GezginRotası2.FoodsPage"
             Title="🍲 Meşhur Lezzetler"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Başlık ve Şehir Bilgisi -->
        <VerticalStackLayout Grid.Row="0" Padding="20,15,20,5" Spacing="4">
            <Label x:Name="CityTitleLabel" 
                   Text="📍 Tüm Türkiye Lezzetleri" 
                   TextColor="#FF7F00" 
                   FontSize="18" 
                   FontAttributes="Bold"/>
            <Label Text="O yöreye ait en meşhur lezzetler ve mekan tavsiyeleri" 
                   TextColor="#888888" 
                   FontSize="12"/>
        </VerticalStackLayout>

        <!-- Kategori Filtre Butonları -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="15,10">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Tümü" Clicked="OnCategoryFilterClicked" BackgroundColor="#FF7F00" TextColor="White" CornerRadius="12" HeightRequest="36" FontSize="12"/>
                <Button Text="Ana Yemek" Clicked="OnCategoryFilterClicked" BackgroundColor="#252525" TextColor="#CCCCCC" CornerRadius="12" HeightRequest="36" FontSize="12"/>
                <Button Text="Tatlı" Clicked="OnCategoryFilterClicked" BackgroundColor="#252525" TextColor="#CCCCCC" CornerRadius="12" HeightRequest="36" FontSize="12"/>
                <Button Text="Sokak Lezzeti" Clicked="OnCategoryFilterClicked" BackgroundColor="#252525" TextColor="#CCCCCC" CornerRadius="12" HeightRequest="36" FontSize="12"/>
                <Button Text="Kahvaltılık" Clicked="OnCategoryFilterClicked" BackgroundColor="#252525" TextColor="#CCCCCC" CornerRadius="12" HeightRequest="36" FontSize="12"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Lezzet Kartları Listesi -->
        <CollectionView Grid.Row="2" 
                        x:Name="FoodsCollection"
                        Margin="15,5,15,15">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:FoodItem">
                    <Grid Padding="0,8">
                        <Border BackgroundColor="#1E1E1E" 
                                StrokeThickness="0" 
                                StrokeShape="RoundRectangle 18">

                            <VerticalStackLayout Spacing="0">

                                <!-- Yemek Görseli & Rozetler -->
                                <Grid HeightRequest="190">
                                    <Image Source="{Binding ImageUrl}" 
                                           Aspect="AspectFill" 
                                           HorizontalOptions="Fill" 
                                           VerticalOptions="Fill"/>

                                    <BoxView Color="#35000000"/>

                                    <!-- Kategori & Şehir Rozeti -->
                                    <HorizontalStackLayout HorizontalOptions="Start" VerticalOptions="Start" Margin="12" Spacing="6">
                                        <Border BackgroundColor="#CC000000" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                            <Label Text="{Binding City}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                                        </Border>
                                        <Border BackgroundColor="#CCFF7F00" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                            <Label Text="{Binding Category}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Puan Rozeti -->
                                    <Border BackgroundColor="#E6000000" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,4" HorizontalOptions="End" VerticalOptions="Start" Margin="12">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="⭐" FontSize="11"/>
                                            <Label Text="{Binding Rating}" TextColor="#FFD700" FontAttributes="Bold" FontSize="12"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Açıklama ve Nerede Yenir Alanı -->
                                <VerticalStackLayout Padding="16" Spacing="10">
                                    <Label Text="{Binding Name}" 
                                           TextColor="White" 
                                           FontSize="19" 
                                           FontAttributes="Bold"/>

                                    <Label Text="{Binding Description}" 
                                           TextColor="#CCCCCC" 
                                           FontSize="13" 
                                           LineHeight="1.3"/>

                                    <BoxView HeightRequest="1" Color="#2E2E2E" Margin="0,4"/>

                                    <!-- Nerede Yenir Tavsiyesi -->
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="🍴 Nerede Yenir?" TextColor="#FF7F00" FontSize="12" FontAttributes="Bold"/>
                                            <Label Text="{Binding WhereToEat}" TextColor="#FFFFFF" FontSize="13"/>
                                        </VerticalStackLayout>

                                        <!-- Haritada Ara Butonu -->
                                        <Button Grid.Column="1" 
                                                Text="📍 Yol Tarifi" 
                                                Clicked="OnOpenMapClicked"
                                                BackgroundColor="#2D2D2D" 
                                                TextColor="#FF7F00" 
                                                CornerRadius="10" 
                                                FontSize="11" 
                                                HeightRequest="36"
                                                Padding="10,0"/>
                                    </Grid>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>