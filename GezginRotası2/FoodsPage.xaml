<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GezginRotası2"
             x:Class="GezginRotası2.FoodsPage"
             Title="🍲 Meşhur Lezzetler"
             BackgroundColor="#0D0F15">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- 1. Başlık ve Şehir Bilgisi -->
        <Border Grid.Row="0" BackgroundColor="#151922" StrokeThickness="0" Padding="18,14">
            <VerticalStackLayout Spacing="3">
                <Label x:Name="CityTitleLabel" 
                       Text="📍 Tüm Türkiye Lezzetleri" 
                       TextColor="#FF7F00" 
                       FontSize="18" 
                       FontAttributes="Bold"/>
                <Label x:Name="CitySubtitleLabel"
                       Text="O yöreye ait en meşhur imza lezzetler ve restoran tavsiyeleri" 
                       TextColor="#8E95A5" 
                       FontSize="11"/>
            </VerticalStackLayout>
        </Border>

        <!-- 2. Modern Kategori Filtre Chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="15,10">
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="BtnFoodAll" Text="Tümü" Clicked="OnCategoryFilterClicked" BackgroundColor="#FF7F00" TextColor="White" CornerRadius="12" HeightRequest="36" FontSize="12" FontAttributes="Bold"/>
                <Button x:Name="BtnFoodMain" Text="Ana Yemek" Clicked="OnCategoryFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="36" FontSize="12"/>
                <Button x:Name="BtnFoodDessert" Text="Tatlı" Clicked="OnCategoryFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="36" FontSize="12"/>
                <Button x:Name="BtnFoodStreet" Text="Sokak Lezzeti" Clicked="OnCategoryFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="36" FontSize="12"/>
                <Button x:Name="BtnFoodBreakfast" Text="Kahvaltılık" Clicked="OnCategoryFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="36" FontSize="12"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 3. Lezzet Kartları Listesi -->
        <CollectionView Grid.Row="2" 
                        x:Name="FoodsCollection"
                        Margin="15,4,15,15">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:FoodItem">
                    <Grid Padding="0,6">
                        <Border BackgroundColor="#181B24" 
                                Stroke="#262C3A" 
                                StrokeThickness="1" 
                                StrokeShape="RoundRectangle 18">

                            <VerticalStackLayout Spacing="0">

                                <!-- Yemek Görseli & Rozetler -->
                                <Grid HeightRequest="180">
                                    <Image Source="{Binding ImageUrl}" 
                                           Aspect="AspectFill" 
                                           HorizontalOptions="Fill" 
                                           VerticalOptions="Fill"/>

                                    <!-- Kategori & Şehir Rozeti -->
                                    <HorizontalStackLayout HorizontalOptions="Start" VerticalOptions="Start" Margin="12" Spacing="6">
                                        <Border BackgroundColor="#CC000000" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                            <Label Text="{Binding City}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                                        </Border>
                                        <Border BackgroundColor="#CCFF7F00" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                            <Label Text="{Binding Category}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Puan Rozeti -->
                                    <Border BackgroundColor="#E6000000" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,4" HorizontalOptions="End" VerticalOptions="Start" Margin="12">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="⭐" FontSize="11"/>
                                            <Label Text="{Binding Rating, StringFormat='{0:F1}'}" TextColor="#FFD700" FontAttributes="Bold" FontSize="11"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Açıklama ve Nerede Yenir Alanı -->
                                <VerticalStackLayout Padding="14" Spacing="8">
                                    <Label Text="{Binding Name}" 
                                           TextColor="White" 
                                           FontSize="17" 
                                           FontAttributes="Bold"/>

                                    <Label Text="{Binding Description}" 
                                           TextColor="#A0A5B5" 
                                           FontSize="12" 
                                           LineHeight="1.3"/>

                                    <BoxView HeightRequest="1" Color="#222836" Margin="0,4"/>

                                    <!-- Nerede Yenir Tavsiyesi & Harita -->
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="🍴 Tavsiye Mekanlar:" TextColor="#FF7F00" FontSize="11" FontAttributes="Bold"/>
                                            <Label Text="{Binding WhereToEat}" TextColor="#FFFFFF" FontSize="12" LineHeight="1.2"/>
                                        </VerticalStackLayout>

                                        <!-- Haritada Ara Butonu -->
                                        <Button Grid.Column="1" 
                                                Text="📍 Harita" 
                                                Clicked="OnOpenMapClicked"
                                                BackgroundColor="#FF7F00" 
                                                TextColor="White" 
                                                FontAttributes="Bold"
                                                CornerRadius="10" 
                                                FontSize="11" 
                                                HeightRequest="34"
                                                Padding="10,0"/>
                                    </Grid>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>