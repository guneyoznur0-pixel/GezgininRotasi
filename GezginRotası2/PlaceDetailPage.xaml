<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GezginRotası2.PlaceDetailPage"
             Title="Mekan Detayı">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Image x:Name="ImgPlace" 
       HeightRequest="300" 
       WidthRequest="400"
       Aspect="AspectFill"
       BackgroundColor="LightGray"
       HorizontalOptions="FillAndExpand" />

            <VerticalStackLayout Padding="20" Spacing="15">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label x:Name="LblName" FontSize="28" FontAttributes="Bold" TextColor="Black" />
                    <Label x:Name="LblRating" FontSize="18" TextColor="Orange" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label x:Name="LblLocation" FontSize="16" TextColor="Gray" />

                <BoxView HeightRequest="1" Color="LightGray" HorizontalOptions="Fill" />

                <Label Text="Hakkında" FontSize="20" FontAttributes="Bold" TextColor="Black" />
                <Label x:Name="LblDescription" FontSize="16" LineHeight="1.5" TextColor="#444" />

                <Button Text="📍 Haritada Gör" 
        Clicked="OnShowMapClicked"
        Margin="0,20,0,0" 
        CornerRadius="10" 
        BackgroundColor="#CCFF7F00" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>