<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GezginRotası2"
             x:Class="GezginRotası2.PlaceDetailPage"
             x:DataType="local:Place"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <!-- Kapak Görseli ve Puan -->
            <Grid HeightRequest="280">
                <Image Source="{Binding ImageUrl}"
                       Aspect="AspectFill"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill" />

                <BoxView Color="#40000000" />

                <!-- Puan Rozeti -->
                <Border BackgroundColor="#E6000000"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        Padding="12,6"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Margin="15">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="⭐" FontSize="14" VerticalOptions="Center" />
                        <Label Text="{Binding Rating}" 
                               TextColor="#FFD700" 
                               FontAttributes="Bold" 
                               FontSize="15" 
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- İçerik Alanı -->
            <VerticalStackLayout Padding="20" Spacing="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Name}"
                           TextColor="White"
                           FontSize="24"
                           FontAttributes="Bold" />

                    <HorizontalStackLayout Spacing="6">
                        <Label Text="📍" FontSize="14" />
                        <Label Text="{Binding Location}"
                               TextColor="#AAAAAA"
                               FontSize="14" />
                        <Label Text="•" TextColor="#666666" Margin="4,0" />
                        <Label Text="{Binding Category}"
                               TextColor="#FF7F00"
                               FontAttributes="Bold"
                               FontSize="14" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#2A2A2A" />

                <VerticalStackLayout Spacing="8">
                    <Label Text="Hakkında"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Label Text="{Binding Description}"
                           TextColor="#DDDDDD"
                           FontSize="15"
                           LineHeight="1.3" />
                </VerticalStackLayout>

                <!-- Haritada Aç Butonu -->
                <Button Text="🗺️ Haritada Aç / Yol Tarifi"
                        BackgroundColor="#FF7F00"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="50"
                        Margin="0,20,0,10"
                        Clicked="OnOpenMapClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>