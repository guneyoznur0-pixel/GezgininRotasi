<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GezginRotası2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GezginRotası2"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#181818"
    Shell.TabBarForegroundColor="#FF7F00"
    Shell.TabBarUnselectedColor="#888888"
    Shell.TabBarTitleColor="#FF7F00"
    BackgroundColor="#121212">

    <TabBar>
        <!-- 1. Sekme: Keşfet (Ana Sayfa) -->
        <Tab Title="Keşfet">
            <ShellContent Title="Keşfet"
                          ContentTemplate="{DataTemplate local:MainPage}"
                          Route="MainPage" />
        </Tab>

        <!-- 2. Sekme: Meşhur Lezzetler -->
        <Tab Title="Lezzetler">
            <ShellContent Title="Lezzetler"
                          ContentTemplate="{DataTemplate local:FoodsPage}"
                          Route="FoodsPage" />
        </Tab>

        <!-- 3. Sekme: Gemini Gezgin AI -->
        <Tab Title="Gezgin AI">
            <ShellContent Title="Gezgin AI"
                          ContentTemplate="{DataTemplate local:AiAssistantPage}"
                          Route="AiAssistantPage" />
        </Tab>

        <!-- 4. Sekme: 81 İl Pasaportum -->
        <Tab Title="Pasaportum">
            <ShellContent Title="Pasaportum"
                          ContentTemplate="{DataTemplate local:PassportPage}"
                          Route="PassportPage" />
        </Tab>
    </TabBar>

</Shell>