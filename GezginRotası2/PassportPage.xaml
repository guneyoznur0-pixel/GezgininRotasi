<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GezginRotası2"
             x:Class="GezginRotası2.PassportPage"
             Title="🇹🇷 Gezgin Pasaportu"
             BackgroundColor="#0D0F15">

    <Grid RowDefinitions="Auto, Auto, Auto, *">

        <!-- 1. Üst İlerleme Kartı (Yüzde ve Seviye) -->
        <Border Grid.Row="0" 
                BackgroundColor="#181B24" 
                StrokeThickness="1" 
                Stroke="#FF7F00" 
                StrokeShape="RoundRectangle 18" 
                Margin="15,10,15,5" 
                Padding="16">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="RankLabel" Text="Yolun Başında" TextColor="#FF7F00" FontSize="18" FontAttributes="Bold"/>
                        <Label x:Name="StatsLabel" Text="0 / 81 İl Gezildi (%0)" TextColor="#A0A5B5" FontSize="13"/>
                    </VerticalStackLayout>

                    <Border Grid.Column="1" BackgroundColor="#262C3A" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,6">
                        <Label x:Name="Badge81Label" Text="🇹🇷 81 İl" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                    </Border>
                </Grid>

                <ProgressBar x:Name="PassportProgressBar" Progress="0.0" ProgressColor="#FF7F00" HeightRequest="8"/>
            </VerticalStackLayout>
        </Border>

        <!-- 2. Başarı Rozetleri (Yatay Kaydırılabilir) -->
        <VerticalStackLayout Grid.Row="1" Padding="15,8,15,2" Spacing="4">
            <Label x:Name="BadgesTitleLabel" Text="🏆 Başarı Rozetleri" TextColor="White" FontSize="14" FontAttributes="Bold"/>
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="BadgesLayout" Spacing="10" Padding="0,5"/>
            </ScrollView>
        </VerticalStackLayout>

        <!-- 3. Bölge Filtre Butonları -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="15,6">
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="BtnRegAll" Text="Tümü" Clicked="OnRegionFilterClicked" BackgroundColor="#FF7F00" TextColor="White" CornerRadius="12" HeightRequest="34" FontSize="11" FontAttributes="Bold"/>
                <Button x:Name="BtnRegMarmara" Text="Marmara" Clicked="OnRegionFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="34" FontSize="11"/>
                <Button x:Name="BtnRegEge" Text="Ege" Clicked="OnRegionFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="34" FontSize="11"/>
                <Button x:Name="BtnRegAkdeniz" Text="Akdeniz" Clicked="OnRegionFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="34" FontSize="11"/>
                <Button x:Name="BtnRegIcanadolu" Text="İç Anadolu" Clicked="OnRegionFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="34" FontSize="11"/>
                <Button x:Name="BtnRegKaradeniz" Text="Karadeniz" Clicked="OnRegionFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="34" FontSize="11"/>
                <Button x:Name="BtnRegDogu" Text="Doğu Anadolu" Clicked="OnRegionFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="34" FontSize="11"/>
                <Button x:Name="BtnRegGuneydogu" Text="Güneydoğu" Clicked="OnRegionFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="34" FontSize="11"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 4. 81 İl Kart Listesi -->
        <CollectionView Grid.Row="3" 
                        x:Name="CitiesCollection"
                        Margin="15,5,15,10">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:CityPassportItem">
                    <Grid Padding="0,4">
                        <Border BackgroundColor="#181B24" 
                                StrokeThickness="1" 
                                Stroke="{Binding CardBorderColor}" 
                                StrokeShape="RoundRectangle 14" 
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCityTapped" CommandParameter="{Binding PlateNumber}"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">

                                <!-- Plaka Rozeti -->
                                <Border Grid.Column="0" 
                                        BackgroundColor="{Binding PlateBgColor}" 
                                        StrokeThickness="0" 
                                        StrokeShape="RoundRectangle 10" 
                                        WidthRequest="40" 
                                        HeightRequest="40">
                                    <Label Text="{Binding PlateNumber}" 
                                           TextColor="White" 
                                           FontAttributes="Bold" 
                                           FontSize="15" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center"/>
                                </Border>

                                <!-- Şehir Adı ve Bölge -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                                    <Label Text="{Binding DisplayRegion}" TextColor="#8E95A5" FontSize="11"/>
                                </VerticalStackLayout>

                                <!-- Gezildi / Gezilecek Butonu -->
                                <Border Grid.Column="2" 
                                        BackgroundColor="#222734" 
                                        StrokeThickness="0" 
                                        StrokeShape="RoundRectangle 10" 
                                        Padding="10,6">
                                    <Label Text="{Binding StatusText}" 
                                           TextColor="{Binding StatusColor}" 
                                           FontSize="12" 
                                           FontAttributes="Bold"/>
                                </Border>

                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>