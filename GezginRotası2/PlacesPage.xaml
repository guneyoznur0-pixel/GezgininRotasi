<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GezginRotası2"
             x:Class="GezginRotası2.PlacesPage"
             BackgroundColor="#121212">

    <CollectionView x:Name="PlacesCollection"
                    SelectionMode="Single"
                    SelectionChanged="OnPlaceSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:Place">
                <Grid Padding="15">
                    <Label Text="{Binding Name}" TextColor="White" FontSize="18" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>