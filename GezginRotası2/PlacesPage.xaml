<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GezginRotası2"
             x:Class="GezginRotası2.PlacesPage"
             Title="📍 Gezilecek &amp; Müzeler"
             BackgroundColor="#0D0F15">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- 1. Üst Başlık & Açıklama -->
        <Border Grid.Row="0" BackgroundColor="#151922" StrokeThickness="0" Padding="18,14">
            <VerticalStackLayout Spacing="3">
                <Label x:Name="PageTitleLabel" Text="📍 Tüm Türkiye Gezilecek Yerler" TextColor="#FF7F00" FontSize="18" FontAttributes="Bold"/>
                <Label x:Name="PageSubtitleLabel" Text="Tarihi yapılar, açık hava müzeleri ve eşsiz doğal güzellikler" TextColor="#8E95A5" FontSize="11"/>
            </VerticalStackLayout>
        </Border>

        <!-- 2. Modern Kategori Filtresi Chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="15,10">
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="BtnFilterAll" Text="Tümü" Clicked="OnCategoryFilterClicked" BackgroundColor="#FF7F00" TextColor="White" CornerRadius="12" HeightRequest="36" FontSize="12" FontAttributes="Bold"/>
                <Button x:Name="BtnFilterSights" Text="Gezilecek" Clicked="OnCategoryFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="36" FontSize="12"/>
                <Button x:Name="BtnFilterMuseums" Text="Müzeler" Clicked="OnCategoryFilterClicked" BackgroundColor="#1E2330" TextColor="#CCCCCC" BorderColor="#2E3545" BorderWidth="1" CornerRadius="12" HeightRequest="36" FontSize="12"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 3. Kart Listesi -->
        <CollectionView Grid.Row="2" x:Name="PlacesCollection" Margin="15,4">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:PlaceItem">
                    <Grid Padding="0,6">
                        <Border BackgroundColor="#181B24" Stroke="#262C3A" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="0">
                            <VerticalStackLayout Spacing="0">

                                <!-- Fotoğraf ve Puan Rozeti -->
                                <Grid HeightRequest="170">
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill"/>

                                    <!-- Şehir Rozeti -->
                                    <Border BackgroundColor="#CC000000" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4" HorizontalOptions="Start" VerticalOptions="Start" Margin="10">
                                        <Label Text="{Binding City}" TextColor="#FF7F00" FontSize="11" FontAttributes="Bold"/>
                                    </Border>

                                    <!-- Puan Rozeti -->
                                    <Border BackgroundColor="#CC000000" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4" HorizontalOptions="End" VerticalOptions="Start" Margin="10">
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="⭐" FontSize="11"/>
                                            <Label Text="{Binding Rating, StringFormat='{0:F1}'}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Açıklama ve Harita Butonu -->
                                <VerticalStackLayout Padding="14" Spacing="8">
                                    <Label Text="{Binding Name}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                                    <Label Text="{Binding Description}" TextColor="#A0A5B5" FontSize="12" LineHeight="1.3"/>

                                    <Button Text="📍 Haritada Gör / Yol Tarifi" 
                                            Clicked="OnMapDirectionsClicked" 
                                            BackgroundColor="#FF7F00" 
                                            TextColor="White" 
                                            FontAttributes="Bold" 
                                            CornerRadius="12" 
                                            HeightRequest="38" 
                                            FontSize="12" 
                                            Margin="0,4,0,0"/>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>