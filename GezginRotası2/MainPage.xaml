<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GezginRotası2.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <Grid>
        <!-- Arka Plan Görseli -->
        <Image Source="https://images.unsplash.com/photo-1524231757912-21f4fe3a7200?q=80&amp;w=2071&amp;auto=format&amp;fit=crop"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <BoxView Color="#90000000" />

        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="20,15,20,30">

                <!-- Arama Çubuğu -->
                <Frame BackgroundColor="White" Padding="2" CornerRadius="20" HasShadow="True">
                    <SearchBar Placeholder="Nereye gitmek istersiniz?" PlaceholderColor="Gray" TextColor="Black" BackgroundColor="Transparent" />
                </Frame>

                <!-- Şehir Seçim Menüsü -->
                <Frame BackgroundColor="#40FFFFFF" CornerRadius="15" Padding="10,0" HasShadow="False">
                    <Picker x:Name="CityPicker" Title="📍 Gezeceğiniz Şehri Seçin" TitleColor="White" TextColor="White" HorizontalOptions="Center" />
                </Frame>

                <!-- 🤖 GEMINI YAPAY ZEKA ASİSTANI KARTI -->
                <Border BackgroundColor="#E61E1E1E" Stroke="#FF7F00" StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="12" HorizontalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAiAssistantClicked" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0" BackgroundColor="#FF7F00" StrokeShape="RoundRectangle 22" WidthRequest="44" HeightRequest="44" StrokeThickness="0">
                            <Label Text="🤖" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                            <Label Text="Yapay Zeka Gezgin Asistanı" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                            <Label Text="Rota çiz, ne yenir sor veya bütçe planla!" TextColor="#CCCCCC" FontSize="11"/>
                        </VerticalStackLayout>

                        <Label Grid.Column="2" Text="➔" TextColor="#FF7F00" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- ✨ ÖZEL GEZGİN ARAÇLARI (YATAY MENÜ) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="🎲 Şans Çarkı / Kararsızım" Clicked="OnSansCarkiClicked" BackgroundColor="#FF9800" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="38" FontSize="12"/>
                        <Button Text="🗣️ Şive Sözlüğü" Clicked="OnSiveSozluguClicked" BackgroundColor="#009688" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="38" FontSize="12"/>
                        <Button Text="🎒 Akıllı Valiz Listesi" Clicked="OnValizClicked" BackgroundColor="#4CAF50" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="38" FontSize="12"/>
                        <Button Text="📸 Kartpostal Paylaş" Clicked="OnKartpostalClicked" BackgroundColor="#E91E63" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="38" FontSize="12"/>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- 6'LI ANA KONTROL PANELİ -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                    <!-- 1. Gezilecek Yerler -->
                    <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#CCFF7F00" HasShadow="True" CornerRadius="18" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGezilecekYerlerTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="🏛️" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="Gezilecek" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- 2. Müzeler -->
                    <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#CC00BCD4" HasShadow="True" CornerRadius="18" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMuzelerTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="🏺" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="Müzeler" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- 3. Ne Yenir? -->
                    <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#CCE91E63" HasShadow="True" CornerRadius="18" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLezzetlerTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="🍲" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="Ne Yenir?" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- 4. Şarkılar & Kültür -->
                    <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#CC3F51B5" HasShadow="True" CornerRadius="18" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnKulturTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="🎧" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="Şarkılar &amp; Kültür" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- 5. Günlüğüm -->
                    <Frame Grid.Row="2" Grid.Column="0" BackgroundColor="#CC4CAF50" HasShadow="True" CornerRadius="18" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGunlukTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="📓" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="Günlüğüm" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- 6. Pasaportum -->
                    <Frame Grid.Row="2" Grid.Column="1" BackgroundColor="#CC9C27B0" HasShadow="True" CornerRadius="18" Padding="14">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPasaportTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="🇹🇷" FontSize="28" HorizontalOptions="Center"/>
                            <Label Text="Pasaportum" TextColor="White" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>