<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GezginRotası2.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0D0F15">

    <Grid>
        <!-- Arka Plan Hafif Gradient & Doğa Görseli -->
        <Image Source="https://images.unsplash.com/photo-1524231757912-21f4fe3a7200?q=80&amp;w=2071&amp;auto=format&amp;fit=crop"
               Aspect="AspectFill"
               Opacity="0.25"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <ScrollView>
            <VerticalStackLayout Spacing="18" Padding="20,25,20,35">

                <!-- 🌟 1. ÜST BAR: BAŞLIK & DİL DEĞİŞTİRME BUTONU -->
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="LblAppTitle" Text="🧭 Gezginin Rotası" TextColor="White" FontSize="22" FontAttributes="Bold"/>
                        <Label x:Name="LblAppSubtitle" Text="81 İlin Kültür, Doğa &amp; Lezzet Rehberi" TextColor="#A0A5B5" FontSize="11"/>
                    </VerticalStackLayout>

                    <!-- Dil Seçici (🇹🇷 TR / 🇬🇧 EN) Rozeti -->
                    <Border Grid.Column="1" 
                            BackgroundColor="#1F2430" 
                            Stroke="#FF7F00" 
                            StrokeThickness="1.2" 
                            StrokeShape="RoundRectangle 16" 
                            Padding="10,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLanguageToggleTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label x:Name="LblLanguageBadge" Text="🇹🇷 TR" TextColor="#FF7F00" FontSize="12" FontAttributes="Bold"/>
                            <Label Text="⇄" TextColor="#888888" FontSize="12"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- 🔍 2. ŞEHİR SEÇİM & ARAMA KARTI -->
                <Border BackgroundColor="#181B24" Stroke="#262B38" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,10">
                    <VerticalStackLayout Spacing="8">
                        <SearchBar x:Name="CitySearchBar"
                                   Placeholder="Nereye gitmek istersiniz?" 
                                   PlaceholderColor="#707688" 
                                   TextColor="White" 
                                   BackgroundColor="Transparent"
                                   CancelButtonColor="#FF7F00"
                                   TextChanged="OnSearchTextChanged"/>

                        <Border BackgroundColor="#222734" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,2">
                            <Picker x:Name="CityPicker" 
                                    Title="📍 Gezeceğiniz Şehri Seçin" 
                                    TitleColor="#FF7F00" 
                                    TextColor="White" 
                                    HorizontalOptions="FillAndExpand"
                                    SelectedIndexChanged="OnCityPickerChanged"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 🤖 3. MODERN GEMINI YAPAY ZEKA ASİSTANI KARTI -->
                <Border BackgroundColor="#1A1E29" Stroke="#FF7F00" StrokeThickness="1.2" StrokeShape="RoundRectangle 18" Padding="14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAiAssistantClicked" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0" BackgroundColor="#FF7F00" StrokeShape="RoundRectangle 14" WidthRequest="46" HeightRequest="46" StrokeThickness="0">
                            <Label Text="🤖" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="LblAiTitle" Text="Yapay Zeka Gezgin Asistanı" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                            <Label x:Name="LblAiSubtitle" Text="Rota çiz, ne yenir sor veya bütçe planla!" TextColor="#A0A5B5" FontSize="11"/>
                        </VerticalStackLayout>

                        <Border Grid.Column="2" BackgroundColor="#2A2F3D" StrokeShape="RoundRectangle 20" WidthRequest="32" HeightRequest="32" StrokeThickness="0">
                            <Label Text="➔" TextColor="#FF7F00" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 🚀 4. HIZLI GEZGİN ARAÇLARI (YATAY MODERN CHIPS) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="10">
                        <Button x:Name="BtnWheel" Text="🎲 Şans Çarkı" Clicked="OnSansCarkiClicked" BackgroundColor="#1E2330" TextColor="#FFB300" BorderColor="#353D50" BorderWidth="1" FontAttributes="Bold" CornerRadius="14" HeightRequest="38" FontSize="12"/>
                        <Button x:Name="BtnDialect" Text="🗣️ Şive Sözlüğü" Clicked="OnSiveSozluguClicked" BackgroundColor="#1E2330" TextColor="#00BFA5" BorderColor="#353D50" BorderWidth="1" FontAttributes="Bold" CornerRadius="14" HeightRequest="38" FontSize="12"/>
                        <Button x:Name="BtnPacking" Text="🎒 Akıllı Valiz" Clicked="OnValizClicked" BackgroundColor="#1E2330" TextColor="#66BB6A" BorderColor="#353D50" BorderWidth="1" FontAttributes="Bold" CornerRadius="14" HeightRequest="38" FontSize="12"/>
                        <Button x:Name="BtnPostcard" Text="📸 Kartpostal" Clicked="OnKartpostalClicked" BackgroundColor="#1E2330" TextColor="#FF4081" BorderColor="#353D50" BorderWidth="1" FontAttributes="Bold" CornerRadius="14" HeightRequest="38" FontSize="12"/>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- 🏛️ 5. ANA KEŞİF KARTLARI (6'LI MODERN GRID) -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                    <!-- 1. Gezilecek Yerler -->
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#181B24" Stroke="#2A3040" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGezilecekYerlerTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Border BackgroundColor="#2A2218" StrokeShape="RoundRectangle 14" WidthRequest="44" HeightRequest="44" StrokeThickness="0">
                                <Label Text="🏛️" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label x:Name="LblMenuSights" Text="Gezilecek" TextColor="White" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 2. Müzeler -->
                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#181B24" Stroke="#2A3040" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMuzelerTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Border BackgroundColor="#14262E" StrokeShape="RoundRectangle 14" WidthRequest="44" HeightRequest="44" StrokeThickness="0">
                                <Label Text="🏺" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label x:Name="LblMenuMuseums" Text="Müzeler" TextColor="White" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. Ne Yenir? -->
                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#181B24" Stroke="#2A3040" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLezzetlerTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Border BackgroundColor="#2D1922" StrokeShape="RoundRectangle 14" WidthRequest="44" HeightRequest="44" StrokeThickness="0">
                                <Label Text="🍲" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label x:Name="LblMenuFoods" Text="Ne Yenir?" TextColor="White" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 4. Şarkılar & Kültür -->
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#181B24" Stroke="#2A3040" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnKulturTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Border BackgroundColor="#1C1E30" StrokeShape="RoundRectangle 14" WidthRequest="44" HeightRequest="44" StrokeThickness="0">
                                <Label Text="🎧" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label x:Name="LblMenuCulture" Text="Şarkılar &amp; Kültür" TextColor="White" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 5. Günlüğüm -->
                    <Border Grid.Row="2" Grid.Column="0" BackgroundColor="#181B24" Stroke="#2A3040" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGunlukTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Border BackgroundColor="#16291C" StrokeShape="RoundRectangle 14" WidthRequest="44" HeightRequest="44" StrokeThickness="0">
                                <Label Text="📓" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label x:Name="LblMenuDiary" Text="Günlüğüm" TextColor="White" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 6. Pasaportum -->
                    <Border Grid.Row="2" Grid.Column="1" BackgroundColor="#181B24" Stroke="#2A3040" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPasaportTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Border BackgroundColor="#2A182E" StrokeShape="RoundRectangle 14" WidthRequest="44" HeightRequest="44" StrokeThickness="0">
                                <Label Text="🇹🇷" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label x:Name="LblMenuPassport" Text="Pasaportum" TextColor="White" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>